# runtime data (SQLite db, uploaded images, thumbnails) -> NAS volume
/data/
!/data/.gitkeep

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# editor
.vscode/
.idea/

# os
Thumbs.db
.DS_Store

# stray files that occasionally land in the repo root (downloads, code-runner)
*.part
*.ytdl
tempCodeRunnerFile.*
