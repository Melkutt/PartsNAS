{
  "_comment": "Built-in rules that turn a part's package text into a KiCad footprint. Each rule: `when` = regular expressions (case-insensitive) that must ALL match: `case` = the supplier's Package / Case, `device` = Supplier Device Package, `raw` = the part's own Footprint text; optional `scope` = a word the category path must contain; `assumed` = true when the rule only guesses the common variant (shown unticked). First match wins; your own rules (Settings) are tried before these. Every footprint name was checked against KiCad's own libraries.",
  "rules": [
    {"id": "soic-8-narrow", "when": {"case": "^(?!.*exposed).*\\b8-SOIC\\b.*3\\.90mm"}, "footprint": "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm"},
    {"id": "soic-8-wide", "when": {"case": "^(?!.*exposed).*\\b8-SOIC\\b.*5\\.30mm"}, "footprint": "Package_SO:SOIC-8W_5.3x5.3mm_P1.27mm"},
    {"id": "soic-14-narrow", "when": {"case": "^(?!.*exposed).*\\b14-SOIC\\b.*3\\.90mm"}, "footprint": "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm"},
    {"id": "soic-16-narrow", "when": {"case": "^(?!.*exposed).*\\b16-SOIC\\b.*3\\.90mm"}, "footprint": "Package_SO:SOIC-16_3.9x9.9mm_P1.27mm"},
    {"id": "soic-16-wide", "when": {"case": "^(?!.*exposed).*\\b16-SOIC\\b.*7\\.50mm"}, "footprint": "Package_SO:SOIC-16W_7.5x10.3mm_P1.27mm"},
    {"id": "msop-8", "when": {"case": "\\b8-[A-Z]*MSOP\\b.*3\\.00mm"}, "footprint": "Package_SO:MSOP-8_3x3mm_P0.65mm"},
    {"id": "msop-10", "when": {"case": "\\b10-[A-Z]*MSOP\\b.*3\\.00mm"}, "footprint": "Package_SO:MSOP-10_3x3mm_P0.5mm"},
    {"id": "tssop-8", "when": {"case": "^(?!.*MSOP).*\\b8-TSSOP\\b.*4\\.40mm"}, "footprint": "Package_SO:TSSOP-8_4.4x3mm_P0.65mm"},
    {"id": "dip-8", "when": {"case": "\\b8-DIP\\b.*7\\.62mm"}, "footprint": "Package_DIP:DIP-8_W7.62mm"},
    {"id": "dip-14", "when": {"case": "\\b14-DIP\\b.*7\\.62mm"}, "footprint": "Package_DIP:DIP-14_W7.62mm"},
    {"id": "dip-16", "when": {"case": "\\b16-DIP\\b.*7\\.62mm"}, "footprint": "Package_DIP:DIP-16_W7.62mm"},
    {"id": "dip-24", "when": {"case": "\\b24-DIP\\b.*7\\.62mm"}, "footprint": "Package_DIP:DIP-24_W7.62mm"},
    {"id": "tqfp-44", "when": {"device": "\\b44-TQFP\\b.*10x10"}, "footprint": "Package_QFP:TQFP-44_10x10mm_P0.8mm"},
    {"id": "tqfp-32", "when": {"device": "\\b32-TQFP\\b.*7x7"}, "footprint": "Package_QFP:TQFP-32_7x7mm_P0.8mm"},
    {"id": "sot-23-5", "when": {"case": "SC-74A|SOT-753|^SOT-23-5$"}, "footprint": "Package_TO_SOT_SMD:SOT-23-5"},
    {"id": "tsot-23-6", "when": {"case": "TSOT-23-6"}, "footprint": "Package_TO_SOT_SMD:TSOT-23-6"},
    {"id": "sot-23-6", "when": {"case": "^SOT-23-6$"}, "footprint": "Package_TO_SOT_SMD:SOT-23-6"},
    {"id": "sot-23", "when": {"case": "TO-236|SOT-23-3|^SOT-23$"}, "footprint": "Package_TO_SOT_SMD:SOT-23"},
    {"id": "sot-323", "when": {"case": "\\bSC-70\\b.*SOT-323|^SOT-323$"}, "footprint": "Package_TO_SOT_SMD:SOT-323_SC-70"},
    {"id": "sot-343", "when": {"case": "SC-82A|SOT-343"}, "footprint": "Package_TO_SOT_SMD:SOT-343_SC-70-4"},
    {"id": "sot-353", "when": {"case": "SOT-353"}, "footprint": "Package_TO_SOT_SMD:SOT-353_SC-70-5"},
    {"id": "sot-363", "when": {"case": "SOT-363"}, "footprint": "Package_TO_SOT_SMD:SOT-363_SC-70-6"},
    {"id": "sot-223", "when": {"case": "TO-261|SOT-223"}, "footprint": "Package_TO_SOT_SMD:SOT-223-3_TabPin2"},
    {"id": "to-252", "when": {"case": "TO-252|DPAK"}, "footprint": "Package_TO_SOT_SMD:TO-252-2"},
    {"id": "to-263", "when": {"case": "TO-263|D2PAK"}, "footprint": "Package_TO_SOT_SMD:TO-263-2"},
    {"id": "to-220f", "when": {"case": "TO-220.*Full Pack"}, "footprint": "Package_TO_SOT_THT:TO-220F-3_Vertical"},
    {"id": "to-220", "when": {"case": "^TO-220(-3)?$"}, "footprint": "Package_TO_SOT_THT:TO-220-3_Vertical"},
    {"id": "to-247-3", "when": {"case": "^TO-247-3$"}, "footprint": "Package_TO_SOT_THT:TO-247-3_Vertical"},
    {"id": "to-247-2", "when": {"case": "^TO-247-2$"}, "footprint": "Package_TO_SOT_THT:TO-247-2_Vertical"},
    {"id": "to-126", "when": {"case": "TO-225AA|TO-126-3"}, "footprint": "Package_TO_SOT_THT:TO-126-3_Vertical"},
    {"id": "to-218", "when": {"case": "TO-218|^TOP-3$|SOT-93"}, "footprint": "Package_TO_SOT_THT:TO-218-3_Vertical"},
    {"id": "to-92", "when": {"case": "^TO-226-3, TO-92-3 \\(TO-226AA\\)$"}, "footprint": "Package_TO_SOT_THT:TO-92"},
    {"id": "to-3", "when": {"case": "^TO-3$"}, "footprint": "Package_TO_SOT_THT:TO-3"},
    {"id": "do-214ac", "when": {"case": "\\bDO-214AC\\b"}, "footprint": "Diode_SMD:D_SMA"},
    {"id": "do-214aa", "when": {"case": "\\bDO-214AA\\b"}, "footprint": "Diode_SMD:D_SMB"},
    {"id": "do-214ab", "when": {"case": "\\bDO-214AB\\b"}, "footprint": "Diode_SMD:D_SMC"},
    {"id": "minimelf", "when": {"case": "MINI-MELF|SOD-80"}, "footprint": "Diode_SMD:D_MiniMELF"},

    {"id": "raw-sot-23-5", "when": {"raw": "^SOT-23-5$"}, "footprint": "Package_TO_SOT_SMD:SOT-23-5"},
    {"id": "raw-sot-23-6", "when": {"raw": "^SOT-23-6$"}, "footprint": "Package_TO_SOT_SMD:SOT-23-6"},
    {"id": "raw-sot-23", "when": {"raw": "^SOT-23(-3)?$"}, "footprint": "Package_TO_SOT_SMD:SOT-23"},
    {"id": "raw-sot-323", "when": {"raw": "^SOT-323$"}, "footprint": "Package_TO_SOT_SMD:SOT-323_SC-70"},
    {"id": "raw-sot-353", "when": {"raw": "^SOT-353$"}, "footprint": "Package_TO_SOT_SMD:SOT-353_SC-70-5"},
    {"id": "raw-sot-363", "when": {"raw": "^SOT-363$"}, "footprint": "Package_TO_SOT_SMD:SOT-363_SC-70-6"},
    {"id": "raw-sot-223", "when": {"raw": "^SOT-223(-3)?$"}, "footprint": "Package_TO_SOT_SMD:SOT-223-3_TabPin2"},
    {"id": "raw-soic-8", "when": {"raw": "^SOIC-8$"}, "footprint": "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm", "assumed": true},
    {"id": "raw-soic-14", "when": {"raw": "^SOIC-14$"}, "footprint": "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm", "assumed": true},
    {"id": "raw-soic-16", "when": {"raw": "^SOIC-16$"}, "footprint": "Package_SO:SOIC-16_3.9x9.9mm_P1.27mm", "assumed": true},
    {"id": "raw-msop-8", "when": {"raw": "^(MSOP|VSSOP)-8$"}, "footprint": "Package_SO:MSOP-8_3x3mm_P0.65mm", "assumed": true},
    {"id": "raw-msop-10", "when": {"raw": "^MSOP-10$"}, "footprint": "Package_SO:MSOP-10_3x3mm_P0.5mm", "assumed": true},
    {"id": "raw-tqfp-44", "when": {"raw": "^TQFP-44$"}, "footprint": "Package_QFP:TQFP-44_10x10mm_P0.8mm", "assumed": true},
    {"id": "raw-tqfp-32", "when": {"raw": "^TQFP-32$"}, "footprint": "Package_QFP:TQFP-32_7x7mm_P0.8mm", "assumed": true},
    {"id": "raw-dip-8", "when": {"raw": "^P?DIP-8$"}, "footprint": "Package_DIP:DIP-8_W7.62mm", "assumed": true},
    {"id": "raw-dip-14", "when": {"raw": "^P?DIP-14$"}, "footprint": "Package_DIP:DIP-14_W7.62mm", "assumed": true},
    {"id": "raw-dip-16", "when": {"raw": "^P?DIP-16$"}, "footprint": "Package_DIP:DIP-16_W7.62mm", "assumed": true},
    {"id": "raw-dpak", "when": {"raw": "^D?PAK$"}, "footprint": "Package_TO_SOT_SMD:TO-252-2", "assumed": true},
    {"id": "raw-to-220", "when": {"raw": "^TO-220(-3)?$"}, "footprint": "Package_TO_SOT_THT:TO-220-3_Vertical", "assumed": true},
    {"id": "raw-to-92", "when": {"raw": "^TO-92(-3)?$"}, "footprint": "Package_TO_SOT_THT:TO-92", "assumed": true}
  ]
}
